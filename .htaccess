# ===================================================
# Kasyap Diamond ERP - Root Web Security (.htaccess)
# Apache 2.4 Enterprise Hardening
# ===================================================

# Disable directory listing
Options -Indexes

# Disable Server Signature
ServerSignature Off

# Block direct access to sensitive file extensions
<FilesMatch "\.(sql|bat|ps1|log|md|txt|env|ini|yml|yaml|json|lock|bak|sh)$">
    Require all denied
</FilesMatch>

# Block web access to internal source directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|includes|database|backups|migrations|scratch|logs)(/.*)?$ - [F,L,NC]
</IfModule>

# Secondary protection rule
<IfModule !mod_rewrite.c>
    RedirectMatch 403 ^/(config|includes|database|backups|migrations|scratch|logs)(/.*)?$
</IfModule>

# Security HTTP Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
